{
  "name": "instituto-tecnologico-san-miguel",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.18.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "check:supabase": "node --env-file-if-exists=.env.local scripts/check-supabase.mjs",
    "test:contextual-mfa": "node --test scripts/contextual-mfa.test.mjs",
    "test:invitations": "node --test scripts/invitations.test.mjs",
    "test:confirmation-link": "node --test scripts/confirmation-link.test.mjs",
    "test:accounts": "node --test scripts/account-management.test.mjs scripts/account-resources.test.mjs",
    "test:privacy": "node --test scripts/portal-privacy.test.mjs",
    "qa:mfa": "node scripts/qa-mfa-feedback.mjs",
    "test:motion": "node --test scripts/motion-preferences.test.mjs",
    "test:services": "node --test scripts/supabase-probe.test.mjs",
    "seed:demo": "node --env-file-if-exists=.env.local scripts/seed-demo.mjs",
    "demo:credential": "node --env-file-if-exists=.env.local scripts/show-demo-credential.mjs",
    "backup:project": "node --env-file-if-exists=.env.local scripts/backup-project.mjs",
    "test:local-http": "node --test scripts/local-http.test.mjs"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.5",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "minimatch@10": "11.0.5"
  }
}
