      "html": "<button class=\"ds-primary\">Continuar</button>",
      "css": ".ds-primary{font-family:var(--font-manrope),sans-serif;font-size:15px;cursor:pointer;transition:background .2s,color .2s,transform .3s cubic-bezier(.16,1,.3,1);display:inline-flex;align-items:center;justify-content:center;gap:20px;padding:13px 22px;border-radius:7px;text-decoration:none;font-weight:700;min-height:46px;line-height:1.35;border:1px solid transparent;white-space:normalbackground:var(--action);color:var(--action-ink)}.ds-primary:hover{filter:brightness(.93);transform:translateY(-1px)}.ds-primary:focus-visible{outline:3px solid var(--action);outline-offset:4px;}.ds-primary:disabled{opacity:.55;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none;}}"
