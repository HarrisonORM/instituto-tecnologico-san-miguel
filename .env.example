# Plantilla sin valores reales. Copiar a .env.local en la raiz del proyecto.
# Completar unicamente tras crear o seleccionar el proyecto gratuito de Supabase.
# URL del proyecto y clave PUBLICABLE (sb_publishable_...), no una clave secreta.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor. Completar después, antes de habilitar invitaciones y recuperación.
SUPABASE_SECRET_KEY=
AUTH_RECOVERY_REDIRECT_URL=
BACKEND_ENABLE_HARD_DELETE=false
# Canal privado de contacto: secreto aleatorio de al menos 32 caracteres.
CONTACT_RATE_LIMIT_SECRET=
DEMO_SEED_ALLOWED=false
DEMO_ACCEPT_SAMPLE_DATA=false
DEMO_PROJECT_REF=
DEMO_SEED_PASSWORD=
DEMO_CREDENTIAL_ACCESS=false
BACKUP_ALLOWED=false
BACKUP_PROJECT_REF=
DATABASE_URL=
# Certificado raíz de PostgreSQL, si es necesario para verify-full.
PGSSLROOTCERT=

# Las claves secretas y service_role se gestionaran solo en el servidor cuando
# sean necesarias. No ponerlas en variables NEXT_PUBLIC_, en Git ni en el chat.
# Las credenciales SMTP se introducen en el panel de Supabase, no en esta plantilla.
