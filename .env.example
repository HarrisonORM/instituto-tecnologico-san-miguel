# Plantilla sin valores reales. Copiar a .env.local en la raiz del proyecto.
# Completar unicamente tras crear o seleccionar el proyecto gratuito de Supabase.
# URL del proyecto y clave PUBLICABLE (sb_publishable_...), no una clave secreta.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Las claves secretas y service_role se gestionaran solo en el servidor cuando
# sean necesarias. No ponerlas en variables NEXT_PUBLIC_, en Git ni en el chat.
# Las credenciales SMTP se introducen en el panel de Supabase, no en esta plantilla.
